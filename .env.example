# Copy to .env for local (non-Docker) runs. Compose sets these itself.
# Ports match docker-compose.override.yml, which shifts them off the defaults so
# they don't collide with a Postgres/Redis already installed on the host.
DATABASE_URL=postgresql+asyncpg://chess:chess@localhost:5433/chess
REDIS_URL=redis://localhost:6380/0

# Optional. Raises Lichess rate limits; the app works without it.
LICHESS_TOKEN=

# Lichess asks for a descriptive User-Agent with a contact URL. Put yours here.
LICHESS_USER_AGENT=chess-wrapped/0.1 (+https://github.com/you/chess-wrapped)

DEBUG=false
